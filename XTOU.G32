' ==============================================================================
'##E#
' Title:       XTOOL Type Overlay Util (RichEdit Native PopUp Version)
' Author:      Xavier
' Assistance:  Co-authored with AI
' Date:        June 11, 2026
' Description: On-screen display text overlay utility featuring selection-based
'              alignment control using the native GB32 PopUp function.
'              Select text then Ctrl+L|E|R for {left, center, right} alignment.
' ==============================================================================

$Library "UpdateRT"
UpdateRuntime      ' Patches GfaWin23.Ocx
$Library "Lib_SetObjectTranKey"

P_Inits

$Group "INITS"
Proc P_Inits
  Global Long BoxOldProc
  Global Long hMsgHook
  Global Long Win1OldProc
  Global Bool AppRunning

  ' Win32 API Constants
  Const GWL_HWNDPARENT = -8
  Const GWL_WNDPROC    = -4
  Const SWP_NOSIZE     = &H0001
  Const SWP_NOMOVE     = &H0002
  Const SWP_NOACTIVATE = &H0010
  Const HWND_TOPMOST   = -1

  ' Win32 Window Message Constants
  Const WM_SETFOCUS      = &H0007
  Const WM_KILLFOCUS     = &H0008
  Const WM_NCACTIVATE    = &H0086
  Const WM_MOUSEACTIVATE = &H0021
  Const MA_NOACTIVATE    = 3

  ' --- INITIALIZATION ---
  FullW 2
  With Win_2
    .BorderStyle = 0
    .OnTop = True
    .AutoRedraw = 1
    .BackColor = RGB(0, 0, 0)
  EndWith

  FullW 1
  With Win_1
    .BorderStyle = 0
    .OnTop = True
    .AutoRedraw = 1
    .BackColor = RGB(1, 1, 1)
  EndWith

  ~SetWindowLong(Win_1.hWnd, GWL_HWNDPARENT, Win_2.hWnd)

  ForeColor = RGB(255, 255, 0)

  ' Create Ocx RichEdit control with empty string to prevent default formatting drops
  Ocx RichEdit ed1 = "", 0, 0, Win_1.ScaleWidth, Win_1.ScaleHeight
  Dim m = 20, w = Win_1.ScaleWidth, h = Win_1.ScaleHeight

  With ed1
    .BackColor = RGB(1, 1, 1)
    .ForeColor = RGB(255, 255, 0)
    .BorderStyle = 0
    .FontSize = 96
    .FontName = "Cyberverse"
    .MultiLine = True
    .Left = m
    .Top = m
    .Width = w - 2 * m
    .Height = h - 2 * m
    .SelAlignment = 0             ' Set default alignment to Left (0=Left, 1=Right, 2=Center)
    .SelColor = RGB(255, 255, 0)  ' Force formatting selection color
    .SelText = "Ready>" #13 #10   ' Append initial text via rich selection channel
  EndWith
  ed1.SetFocus
  ed1.SelStart = Len(ed1.Text)

  ' Initialize Transparency Layers
  L_SetObjectTranKey Win_2, 128, -1
  L_SetObjectTranKey Win_1, 255, RGB(1, 1, 1)

  ~SetWindowPos(Win_1.hWnd, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE Or SWP_NOSIZE Or SWP_NOACTIVATE)
  ~SetWindowPos(Win_2.hWnd, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE Or SWP_NOSIZE Or SWP_NOACTIVATE)

  BoxOldProc = SetWindowLong(ed1.hWnd, GWL_WNDPROC, ProcAddr(TextBox_FocusProc))
  Win1OldProc = SetWindowLong(Win_1.hWnd, GWL_WNDPROC, ProcAddr(Win1_WndProc))

  Declare Function GetCurrentThreadId Lib "kernel32" () As Long
  Const WH_GETMESSAGE = 3
  hMsgHook = SetWindowsHookEx(WH_GETMESSAGE, ProcAddr(Global_MessageHook), 0, GetCurrentThreadId())

  Const VK_CANCEL = &H03
  AppRunning = True

  ' --- MAIN APP LOOP ---
  Do
    Sleep
    If (GetAsyncKeyState(VK_CANCEL) And &H8000) <> 0
      AppRunning = False
    EndIf
  Loop While AppRunning And Not (Win_1 Is Nothing)

  ' --- CLEANUP BEFORE EXIT ---
  If hMsgHook <> 0
    ~UnhookWindowsHookEx(hMsgHook)
    hMsgHook = 0
  EndIf
  If BoxOldProc <> 0
    ~SetWindowLong(ed1.hWnd, GWL_WNDPROC, BoxOldProc)
    BoxOldProc = 0
  EndIf
  If Win1OldProc <> 0
    ~SetWindowLong(Win_1.hWnd, GWL_WNDPROC, Win1OldProc)
    Win1OldProc = 0
  EndIf

  ' Safely close windows after un-subclassing completes
  If !IsNothing(Win_1) Win_1.Close
  If !IsNothing(Win_2) Win_2.Close
EndProc

$Group "FUNCS"
Function Win1_WndProc(hWnd%, Mess%, wParam%, lParam%) As Long
  Select Case Mess
  Case WM_MOUSEACTIVATE
    Return MA_NOACTIVATE

  Case WM_NCACTIVATE
    Return CallWindowProc(Win1OldProc, hWnd, Mess, 1, lParam)

  EndSelect
  Return CallWindowProc(Win1OldProc, hWnd, Mess, wParam, lParam)
EndFunction

Function TextBox_FocusProc(hWnd%, Mess%, wParam%, lParam%) As Long
  Const WM_CHAR  = &H0102
  Const WM_PASTE = &H0302
  Select Case Mess
  Case WM_SETFOCUS
    ed1.SelColor = RGB(255, 255, 0)
    L_SetObjectTranKey Win_1, 255, RGB(1, 1, 1)
    ~SetWindowPos(Win_2.hWnd, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE Or SWP_NOSIZE Or SWP_NOACTIVATE)
    ~SetWindowPos(Win_1.hWnd, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE Or SWP_NOSIZE)

  Case WM_KILLFOCUS
    ed1.SelColor = RGB(255, 255, 0)
    L_SetObjectTranKey Win_1, 255, RGB(1, 1, 1)
    ~SetWindowPos(Win_2.hWnd, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE Or SWP_NOSIZE Or SWP_NOACTIVATE)
    ~SetWindowPos(Win_1.hWnd, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE Or SWP_NOSIZE Or SWP_NOACTIVATE)

  Case WM_CHAR, WM_PASTE
    ed1.SelColor = RGB(255, 255, 0)
  EndSelect
  Return CallWindowProc(BoxOldProc, hWnd, Mess, wParam, lParam)
EndFunction

Function Global_MessageHook(ByVal nCode%, ByVal wParam%, ByVal lParam%) As Long
  Const HC_ACTION = 0
  Const WM_MOUSEWHEEL = &H20A
  Const WM_SYSCOMMAND = &H112
  Const SC_CLOSE      = &HF060
  Local Long msgType, wpValue
  Local Short delta
  Local Long oldStart, oldLen, newSize

  If nCode = HC_ACTION
    msgType = Long{lParam + 4}
    wpValue = Long{lParam + 8}

    Select Case msgType
    Case WM_MOUSEWHEEL
      delta = HiWord(wpValue)
      newSize = ed1.FontSize
      If delta > 0
        If newSize < 200
          newSize = newSize + 4
        EndIf
      Else
        If newSize > 8
          newSize = newSize - 4
        EndIf
      EndIf

      If newSize <> ed1.FontSize
        ' Save current text selection state
        oldStart = ed1.SelStart
        oldLen = ed1.SelLength

        ' Select the entire control text to cleanly alter the wrapper attributes
        ed1.SelStart = 0
        ed1.SelLength = ed1.TextLength
        ed1.FontSize = newSize
        ed1.SelColor = RGB(255, 255, 0)

        ' Restore original selection block/caret position
        ed1.SelStart = oldStart
        ed1.SelLength = oldLen
        ed1.SelColor = RGB(255, 255, 0)
      EndIf

    Case WM_SYSCOMMAND
      If (wpValue And &HFFF0) = SC_CLOSE
        AppRunning = False
        Long{lParam + 4} = 0  ' Mutate message to WM_NULL to defer close for safe loop breakdown
      EndIf
    EndSelect
  EndIf
  Return CallNextHookEx(hMsgHook, nCode, wParam, lParam)
EndFunction

$Group "EVENTS"
Sub ed1_MouseUp(Button&, Shift&, X!, Y!)
  Const RIGHT_CLICK = 2
  Local Int32 choice
  Local String menuItems$

  If Button = RIGHT_CLICK
    ' Construct the string mapping items separated by the pipe character
    ' Using Chr(9) to right-justify the hotkey layout display text
    menuItems$ = "Align &Left" + Chr(9) + "Ctrl+L|Align &Center" + Chr(9) + "Ctrl+E|Align &Right" + Chr(9) + "Ctrl+R"

    ' Execute the native PopUp function at the current mouse position (i = -1)
    choice = PopUp(menuItems$, 0, 0, -1)

    ' Act based on the 0-based index position returned
    Select Case choice
    Case 0 ' Align Left
      ed1.SelAlignment = 0
      ed1.SelColor = RGB(255, 255, 0)
    Case 1 ' Align Center
      ed1.SelAlignment = 2
      ed1.SelColor = RGB(255, 255, 0)
    Case 2 ' Align Right
      ed1.SelAlignment = 1
      ed1.SelColor = RGB(255, 255, 0)
    EndSelect
  EndIf
EndSub

Sub ed1_KeyPress(Ascii&)
  Const VK_ESCAPE = &H1B
  If Ascii = VK_ESCAPE
    AppRunning = False  ' Stop loop execution safely without triggering window thread drops
  EndIf
EndSub

Sub Win_1_MessageProc(hWnd%, Mess%, wParam%, lParam%, Retval%, ValidRet?)
EndSub
